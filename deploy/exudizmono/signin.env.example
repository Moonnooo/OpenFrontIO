# Save actual values only as /opt/frontrank/signin.env, owned by root, mode 600.
# Only the API container reads this file. Never commit signin.env.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A verified sending address on a Resend account. Change the transport code if
# choosing an existing SMTP/email service instead. No account was purchased.
RESEND_API_KEY=
MAIL_FROM=
